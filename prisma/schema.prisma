generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATTENDANT
  TECHNICIAN

  @@map("role_enum")
}

enum OutboxActionStatus {
  DELETE
  UPDATE
  INSERT

  @@map("outbox_action_status")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(255)
  lastName     String    @map("last_name") @db.VarChar(255)
  phoneNumber  String?   @map("phone_number") @db.VarChar(15)
  email        String    @unique @db.VarChar(254)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         Role
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  @@map("users")
}

model OutboxUser {
  id          Int                @id @default(autoincrement())
  userId      String             @map("user_id") @db.Uuid
  action      OutboxActionStatus
  beforeState Json               @default("{}") @map("before_state") @db.JsonB
  afterState  Json?              @map("after_state") @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz()
  retriedAt   DateTime?          @map("retried_at") @db.Timestamptz()

  @@map("outbox_users")
}