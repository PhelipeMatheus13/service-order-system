generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATTENDANT
  TECHNICIAN

  @@map("role_enum")
}

enum OutboxActionStatus {
  DELETE
  UPDATE
  INSERT

  @@map("outbox_action_status")
}

enum UserResourceValidationType {
  EMAIL

  @@map("user_resource_validation_type")
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  DIAGNOSIS_COMPLETED
  AWAITING_APPROVAL
  IN_MAINTENANCE
  FINALIZED
  AWAITING_DELIVERY
  DELIVERED
  CANCELLED

  @@map("service_order_status_enum")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(255)
  lastName     String    @map("last_name") @db.VarChar(255)
  phoneNumber  String?   @map("phone_number") @db.VarChar(15)
  email        String    @unique @db.VarChar(254)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         Role
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  resourceValidations UserResourceValidation[]
  activationTokens    UserActivationToken[]
  refreshTokens       RefreshToken[]
  serviceOrders       ServiceOrder[]

  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model OutboxUser {
  id          Int                @id @default(autoincrement())
  userId      String             @map("user_id") @db.Uuid
  action      OutboxActionStatus
  beforeState Json?              @map("before_state") @db.JsonB
  afterState  Json?              @map("after_state") @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz()

  @@map("outbox_users")
}

model UserResourceValidation {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                     @map("user_id") @db.Uuid
  resourceType     UserResourceValidationType @map("resource_type")
  challengerNumber String                     @map("challenger_number") @db.VarChar(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt        DateTime                   @map("expires_at") @db.Timestamptz()
  confirmedAt      DateTime?                  @map("confirmed_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resourceType, createdAt(sort: Desc)])
  @@map("user_resource_validations")
}

model UserActivationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  jti        String    @unique @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activation_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jti       String    @unique @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Customer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName   String    @map("first_name") @db.VarChar(255)
  lastName    String    @map("last_name") @db.VarChar(255)
  email       String    @unique @db.VarChar(254)
  phoneNumber String    @map("phone_number") @db.VarChar(15)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz()

  devices Device[]

  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

model Device {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  type         String    @db.VarChar(100)
  brand        String    @db.VarChar(100)
  model        String    @db.VarChar(255)
  color        String    @db.VarChar(100)
  serialNumber String?   @unique @map("serial_number") @db.VarChar(255)
  imei         String?   @unique @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@unique([id, customerId])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@map("devices")
}

model ServiceOrder {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  deviceId        String             @map("device_id") @db.Uuid
  reportedProblem String             @map("reported_problem") @db.Text
  status          ServiceOrderStatus @default(RECEIVED)
  createdById     String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime?          @map("updated_at") @db.Timestamptz()

  device    Device @relation(fields: [deviceId, customerId], references: [id, customerId], onDelete: Restrict)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([deviceId])
  @@index([status, createdAt(sort: Desc)])
  @@map("service_orders")
}
