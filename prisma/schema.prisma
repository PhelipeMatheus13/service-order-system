generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATTENDANT
  TECHNICIAN

  @@map("role_enum")
}

enum OutboxActionStatus {
  DELETE
  UPDATE
  INSERT

  @@map("outbox_action_status")
}

enum UserResourceValidationType {
  EMAIL

  @@map("user_resource_validation_type")
}

enum ServiceOrderStatus {
  WAITING_DIAGNOSIS
  IN_DIAGNOSIS
  AWAITING_QUOTE
  AWAITING_APPROVAL
  AWAITING_MAINTENANCE
  IN_MAINTENANCE
  AWAITING_DELIVERY
  DELIVERED
  CANCELLED

  @@map("service_order_status_enum")
}

enum ServiceOrderStatusChangeSource {
  USER
  SYSTEM

  @@map("service_order_status_change_source_enum")
}

enum DiagnosisResult {
  FAULT_FOUND
  NO_FAULT_FOUND
  INCONCLUSIVE

  @@map("diagnosis_result_enum")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(255)
  lastName     String    @map("last_name") @db.VarChar(255)
  phoneNumber  String?   @map("phone_number") @db.VarChar(15)
  email        String    @unique @db.VarChar(254)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         Role
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  resourceValidations         UserResourceValidation[]
  activationTokens            UserActivationToken[]
  refreshTokens               RefreshToken[]
  serviceOrders               ServiceOrder[]
  serviceOrderStatusHistories ServiceOrderStatusHistory[]
  diagnoses                   Diagnosis[]
  findings                    Finding[]

  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model OutboxUser {
  id          Int                @id @default(autoincrement())
  userId      String             @map("user_id") @db.Uuid
  action      OutboxActionStatus
  beforeState Json?              @map("before_state") @db.JsonB
  afterState  Json?              @map("after_state") @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz()

  @@map("outbox_users")
}

model UserResourceValidation {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                     @map("user_id") @db.Uuid
  resourceType     UserResourceValidationType @map("resource_type")
  challengerNumber String                     @map("challenger_number") @db.VarChar(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt        DateTime                   @map("expires_at") @db.Timestamptz()
  confirmedAt      DateTime?                  @map("confirmed_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resourceType, createdAt(sort: Desc)])
  @@map("user_resource_validations")
}

model UserActivationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  jti        String    @unique @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activation_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jti       String    @unique @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Customer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName   String    @map("first_name") @db.VarChar(255)
  lastName    String    @map("last_name") @db.VarChar(255)
  email       String    @unique @db.VarChar(254)
  phoneNumber String    @map("phone_number") @db.VarChar(15)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz()

  devices Device[]

  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

model Device {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  type         String    @db.VarChar(100)
  brand        String    @db.VarChar(100)
  model        String    @db.VarChar(255)
  color        String    @db.VarChar(100)
  serialNumber String?   @unique @map("serial_number") @db.VarChar(255)
  imei         String?   @unique @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@unique([id, customerId])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@map("devices")
}

model ServiceOrder {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  deviceId        String             @map("device_id") @db.Uuid
  reportedProblem String             @map("reported_problem") @db.Text
  status          ServiceOrderStatus @default(WAITING_DIAGNOSIS)
  createdById     String             @map("created_by") @db.Uuid
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz()
  cancelReason    String?            @map("cancel_reason") @db.Text
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz()
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime?          @map("updated_at") @db.Timestamptz()

  device                      Device                      @relation(fields: [deviceId, customerId], references: [id, customerId], onDelete: Restrict)
  createdBy                   User                        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  serviceOrderStatusHistories ServiceOrderStatusHistory[]
  diagnosis                   Diagnosis?

  @@index([customerId])
  @@index([deviceId])
  @@index([status, createdAt(sort: Desc)])
  @@map("service_orders")
}

model ServiceOrderStatusHistory {
  id             String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String                         @map("service_order_id") @db.Uuid
  fromStatus     ServiceOrderStatus?            @map("from_status")
  toStatus       ServiceOrderStatus             @map("to_status")
  changeSource   ServiceOrderStatusChangeSource @map("change_source")
  changedById    String?                        @map("changed_by") @db.Uuid
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz()

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([serviceOrderId, createdAt(sort: Desc)])
  @@map("service_order_status_history")
}

model Diagnosis {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String           @map("service_order_id") @db.Uuid
  performedById  String           @map("performed_by") @db.Uuid
  result         DiagnosisResult?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz()

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  performedBy  User         @relation(fields: [performedById], references: [id], onDelete: Restrict)
  findings     Finding[]

  @@unique([serviceOrderId])
  @@index([performedById])
  @@map("diagnoses")
}

model Finding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  diagnosisId String   @map("diagnosis_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  description String   @db.Text
  repairable  Boolean
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz()

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([diagnosisId])
  @@index([createdById])
  @@map("findings")
}