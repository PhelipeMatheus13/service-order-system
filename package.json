{
  "name": "service-order-system",
  "description": "REST API for Service order management system",
  "version": "1.0.0",
  "author": "Phelipe Matheus",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PhelipeMatheus13/service-order-system"
  },
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "test": "cross-env NODE_ENV=test jest --coverage --watchAll --detectOpenHandles",
    "test:ci": "cross-env NODE_ENV=test jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit --forceExit --detectOpenHandles",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=tests/integration --forceExit --detectOpenHandles"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/src/server.js",
      "/src/app.js",
      "/src/shared/config/database.js",
      "/src/shared/middlewares/http-logger.middleware.js",
      "/src/shared/utils/logger.js",
      "/src/shared/docs",
      "/src/shared/middlewares/rate-limiter.middleware.js"
    ]
  }
}
